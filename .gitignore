# Clés privées de la PKI du lab (non chiffrées)
/pki/
# Surcharges locales de configuration
/config.local.env
# Outils Go du projet (Go, delve, caches) et binaires compilés
.tools/
bin/
# Remplacements locaux des fichiers de la passerelle (mise au point, voir docs/core.md)
/core/
# Câblage et connexions propres au poste (brancher/débrancher, connexions « local à ce poste »), non distribués
/network.local.yaml
# Anciens fichiers séparés (migrés vers network.local.yaml ; ignorés tant qu'ils traînent)
/attach.local.yaml
/connections.local.yaml
# Surcharges locales des variables de lab (secrets, chemins propres au poste), non versionné
/lab.local.yaml
# Artefacts de distribution (labctl/build.sh release)
/dist/
