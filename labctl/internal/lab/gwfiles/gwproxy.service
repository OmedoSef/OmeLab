[Unit]
Description=Proxy transparent des modules (mitmproxy, connexions via: proxy)
Wants=gw.service
After=gw.service

[Service]
# WEB_PASSWORD : mot de passe de mitmweb (127.0.0.1:8081, joignable par un tunnel SSH depuis l'hôte)
EnvironmentFile=/etc/gwproxy/env
ExecStart=/opt/mitmproxy/mitmweb --mode transparent --listen-port 8080 --web-host 127.0.0.1 --web-port 8081 --showhost \
  --set confdir=/etc/gwproxy --set connection_strategy=lazy --set web_open_browser=false \
  --set web_password=${WEB_PASSWORD} -s /usr/local/lib/gwproxy/gwproxy.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
