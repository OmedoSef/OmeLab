# Réglages des labs (lus par labctl). Valeurs par défaut : pour les changer sans toucher ce fichier,
# créer config.local.env à côté (VAR=valeur, prioritaire, non versionné) ou exporter la variable.

LIBVIRT_DEFAULT_URI="${LIBVIRT_DEFAULT_URI:-qemu:///system}"

# Stockage
LABS_STORAGE_DIR="${LABS_STORAGE_DIR:-$HOME/Virtualisation/kvm}"
LABS_IMAGES_DIR="${LABS_IMAGES_DIR:-$LABS_STORAGE_DIR/images}"   # images cloud de base
LABS_VM_DIR="${LABS_VM_DIR:-$LABS_STORAGE_DIR/vms}"              # un sous-dossier par VM

# Accès aux VMs. Clé publique injectée dans les VMs ; labctl ne présente QUE cette clé (la clé privée à côté, ou
# celle de l'agent SSH) et n'utilise jamais ~/.ssh/config : ni transfert d'agent, ni ProxyJump, ni autres clés
# proposées aux VMs, qui peuvent être hostiles.
LABS_SSH_PUBKEY="${LABS_SSH_PUBKEY:-$HOME/.ssh/id_ed25519.pub}"
LABS_VM_USER="${LABS_VM_USER:-lab}"
LABS_VM_PASSWORD="${LABS_VM_PASSWORD:-lab}"   # console uniquement (SSH par mot de passe désactivé)

# Gabarit par défaut d'une VM
LABS_DEFAULT_IMAGE="${LABS_DEFAULT_IMAGE:-debian13}"
LABS_DEFAULT_NETWORK="${LABS_DEFAULT_NETWORK:-default}"
LABS_DEFAULT_CPUS="${LABS_DEFAULT_CPUS:-1}"
LABS_DEFAULT_MEMORY="${LABS_DEFAULT_MEMORY:-2048}"   # MiB
LABS_DEFAULT_DISK="${LABS_DEFAULT_DISK:-20}"         # GiB

# Clavier des VMs (disposition X11 : fr, us, be, ch...). Vide : celui de ce poste (localectl).
LABS_KEYBOARD="${LABS_KEYBOARD:-}"

# PKI des labs (labctl pki). Si la CA racine existe, chaque VM créée lui fait confiance.
# LABS_PKI_DIR : dossier de la PKI (défaut : pki/ à la racine de Labs)
# Organisation : nom des CA (« <org> Root CA »…) et propriétaire des VMs Windows. À fixer avant « labctl pki init ».
LABS_PKI_ORG="${LABS_PKI_ORG:-OmeLab}"
# Domaine racine des labs. Chaque module et chaque réseau créé par « labctl net create » en reçoit un
# sous-domaine (<reseau>.omelab.internal), et une VM prend le domaine de sa 1re carte : web1.k8s.omelab.internal.
# .internal est réservé aux réseaux privés (jamais un vrai domaine public).
LABS_PKI_DOMAIN="${LABS_PKI_DOMAIN:-omelab.internal}"
