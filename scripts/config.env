# Valeurs par défaut des scripts de lab.
# Pour les surcharger sans toucher ce fichier : créer config.local.env
# (chargé en priorité) ou exporter la variable avant d'appeler un script.

LIBVIRT_DEFAULT_URI="${LIBVIRT_DEFAULT_URI:-qemu:///system}"

# Stockage
LABS_STORAGE_DIR="${LABS_STORAGE_DIR:-$HOME/Virtualisation/kvm}"
LABS_IMAGES_DIR="${LABS_IMAGES_DIR:-$LABS_STORAGE_DIR/images}"   # images cloud de base
LABS_VM_DIR="${LABS_VM_DIR:-$LABS_STORAGE_DIR/vms}"              # un sous-dossier par VM

# Accès aux VMs
LABS_SSH_PUBKEY="${LABS_SSH_PUBKEY:-$HOME/.ssh/id_ed25519.pub}"
LABS_VM_USER="${LABS_VM_USER:-lab}"
LABS_VM_PASSWORD="${LABS_VM_PASSWORD:-lab}"   # console uniquement (SSH par mot de passe désactivé)

# Gabarit par défaut d'une VM
LABS_DEFAULT_IMAGE="${LABS_DEFAULT_IMAGE:-debian13}"
LABS_DEFAULT_NETWORK="${LABS_DEFAULT_NETWORK:-default}"
LABS_DEFAULT_CPUS="${LABS_DEFAULT_CPUS:-2}"
LABS_DEFAULT_MEMORY="${LABS_DEFAULT_MEMORY:-2048}"   # MiB
LABS_DEFAULT_DISK="${LABS_DEFAULT_DISK:-20}"         # GiB

# PKI du lab (voir pki.sh). Si la CA racine existe, elle est injectée
# automatiquement dans chaque VM créée par vm-create.sh.
LABS_PKI_DIR="${LABS_PKI_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/pki}"
LABS_PKI_ORG="${LABS_PKI_ORG:-Omedo Labs}"
# Domaine racine du lab. Chaque réseau créé par net-create.sh en reçoit un sous-domaine
# (<reseau>.omedo.lab), et une VM prend le domaine de sa 1re carte : web1.k8s.omedo.lab
LABS_PKI_DOMAIN="${LABS_PKI_DOMAIN:-omedo.lab}"
